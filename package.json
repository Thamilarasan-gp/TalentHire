{
  "name": "talenthire",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@thamilarasan/server",
    "dev:api": "npm run dev --workspace=@thamilarasan/server",
    "dev:admin": "npm run dev --workspace=@thamilarasan/admin-web",
    "dev:company": "npm run dev --workspace=@thamilarasan/company-web",
    "dev:talent": "npm run dev --workspace=@thamilarasan/talent-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=@thamilarasan/server",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
